# Dependencies — this package ships none, but a profile that links it may
# materialize a node_modules next to a checkout.
node_modules/

# Probe output. Regenerated by the probe scripts; never a source file.
test/probe/fs-probe.txt
test/probe/sandbox-shell-report.txt

# Ad-hoc profile backups. The one historic snapshot worth keeping lives in
# docs/archive/ instead.
*.bak-*
*.bak

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/

# Probe overlays. Their checked-in templates carry @NAME@ placeholders because the
# UNC spelling of a path includes this machine's distro name; the probe scripts
# substitute the real values into these generated copies.
test/probe/.generated-*.yml

# Probe reports for the newer probes, same reason as fs-probe.txt.
test/probe/missing-wsl-report.txt
test/probe/picker-report.txt
test/probe/sandbox-off-report.txt
test/probe/.scratch/

# ZCode session scratch (plan-mode drafts live under plans/).
.zcode/plans/

{
  "name": "dsh-plugin-wsl-env",
  "version": "0.10.0",
  "description": "\u8ba9 DeepSeek Harness \u4ee5 WSL \u5b50\u7cfb\u7edf\u4f5c\u4e3a\u4f1a\u8bdd\u7684\u6267\u884c\u73af\u5883\uff1ashell\u3001\u6587\u4ef6\u8bfb\u5199\u4e0e\u547d\u4ee4\u6267\u884c\u5747\u5728\u5b50\u7cfb\u7edf\u5185\u5b8c\u6210\uff0c\u76ee\u5f55\u9009\u62e9\u5668\u4e0e GUI \u7ec8\u7aef\u540c\u6837\u5b9a\u4f4d\u5230\u5b50\u7cfb\u7edf\u8def\u5f84\uff0c\u5e76\u901a\u8fc7\u5b50\u7cfb\u7edf\u5185\u7684 bubblewrap \u5bf9\u547d\u4ee4\u8fdb\u884c\u6c99\u7bb1\u9694\u79bb",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl",
    "windows"
  ],
  "type": "module",
  "types": "./lib/shell.d.ts",
  "main": "lib/shell.js",
  "exports": {
    ".": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./auto-preset": {
      "types": "./lib/auto-preset.d.ts",
      "default": "./lib/auto-preset.js"
    },
    "./auto-preset/locale/en.json": "./locale/auto-preset/en.json",
    "./auto-preset/locale/zh.json": "./locale/auto-preset/zh.json",
    "./file-reference-wsl": {
      "types": "./lib/file-reference-wsl.d.ts",
      "default": "./lib/file-reference-wsl.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./fs-routing": {
      "types": "./lib/fs-routing.d.ts",
      "default": "./lib/fs-routing.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./paths": {
      "types": "./lib/paths.d.ts",
      "default": "./lib/paths.js"
    },
    "./preflight": {
      "types": "./lib/preflight.d.ts",
      "default": "./lib/preflight.js"
    },
    "./picker": {
      "types": "./lib/picker.d.ts",
      "default": "./lib/picker.js"
    },
    "./picker/locale/en.json": "./locale/picker/en.json",
    "./picker/locale/zh.json": "./locale/picker/zh.json",
    "./preflight/locale/en.json": "./locale/preflight/en.json",
    "./preflight/locale/zh.json": "./locale/preflight/zh.json",
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./shell-env": {
      "types": "./lib/shell-env.d.ts",
      "default": "./lib/shell-env.js"
    },
    "./shell-env/locale/en.json": "./locale/shell-env/en.json",
    "./shell-env/locale/zh.json": "./locale/shell-env/zh.json",
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./subprocess/locale/en.json": "./locale/subprocess/en.json",
    "./subprocess/locale/zh.json": "./locale/subprocess/zh.json",
    "./workspace-files-wsl": {
      "types": "./lib/workspace-files-wsl.d.ts",
      "default": "./lib/workspace-files-wsl.js"
    },
    "./wsl": {
      "types": "./lib/wsl.d.ts",
      "default": "./lib/wsl.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "agent/*.sh",
    "agent/native/linux-*/dsh-wsl-agent",
    "locale/**/*.json",
    "cordis.patch.yml",
    "examples/**/*.yml",
    "README.md",
    "docs/README.zh.md",
    "docs/CONFIGURATION.md",
    "docs/LIMITATIONS.md",
    "docs/PARITY.md",
    "docs/PEER-PARITY.md",
    "docs/UPSTREAM-FSIO-EXPORT.md",
    "docs/UPSTREAM-TERMINAL-TITLE.md",
    "docs/ARCHITECTURE.md",
    "docs/ROADMAP.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "scripts/bootstrap.sh",
    "scripts/diagnose.sh"
  ],
  "scripts": {
    "test": "pnpm run lint:style && pnpm run test:syntax && pnpm run lint:build && pnpm run lint:types && pnpm run test:unit",
    "lint:types": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "lint:build": "node test/build-freshness.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=84 --test-coverage-functions=70 test/agent-exec.test.mjs test/agent-fs-script.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/fs-substrate.test.mjs test/fs.boot.test.mjs test/workspace-files-wsl.test.mjs test/composition.test.mjs test/provider.test.mjs test/file-reference-wsl.test.mjs test/fsio-agent.test.mjs test/fsio-text.test.mjs test/git-route.test.mjs test/listing.test.mjs test/paths.test.mjs test/ports.test.mjs test/preset-choice.test.mjs test/probe-cache.test.mjs test/preflight.test.mjs test/sandbox.test.mjs test/search-exec.test.mjs test/search-route.test.mjs test/shell.test.mjs test/terminal-activity.test.mjs test/terminal.test.mjs test/watcher.test.mjs test/wsl.test.mjs test/fs-decisions.test.mjs test/session-scope.test.mjs test/session-runtime.test.mjs test/native-agent.test.mjs test/peers.test.mjs",
    "test:syntax": "node test/syntax.mjs",
    "test:unit": "node --test test/fs.boot.test.mjs test/fsio-text.test.mjs test/workspace-files-wsl.test.mjs test/composition.test.mjs test/provider.test.mjs test/file-reference-wsl.test.mjs test/paths.test.mjs test/listing.test.mjs test/shell.test.mjs test/terminal.test.mjs test/probe-cache.test.mjs test/preflight.test.mjs test/preset-choice.test.mjs test/sandbox.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/agent-fs-script.test.mjs test/fsio-agent.test.mjs test/fs-substrate.test.mjs test/agent-exec.test.mjs test/ports.test.mjs test/watcher.test.mjs test/wsl.test.mjs test/fs-decisions.test.mjs test/git-route.test.mjs test/fsio-text.test.mjs test/search-route.test.mjs test/search-exec.test.mjs test/terminal-activity.test.mjs test/session-scope.test.mjs test/session-runtime.test.mjs test/native-agent.test.mjs test/peers.test.mjs",
    "lint:style": "node test/style.mjs",
    "prepublishOnly": "pnpm test",
    "probe": "bash test/probe/run.sh",
    "probe:missing-wsl": "bash test/probe/missing-wsl.sh",
    "probe:mode": "bash test/probe/mode.sh",
    "probe:picker": "bash test/probe/picker.sh",
    "probe:sandbox-off": "bash test/probe/sandbox-off.sh",
    "probe:terminal": "bash test/probe/terminal.sh",
    "probe:sandbox": "bash test/probe/sandbox.sh",
    "probe:sandbox-shell": "bash test/probe/sandbox-shell.sh",
    "sync:windows": "bash test/probe/sync-to-windows.sh",
    "probe:watch": "bash test/probe/watch.sh",
    "probe:agent": "bash test/probe/agent.sh",
    "probe:substrate": "bash test/probe/substrate.sh",
    "probe:exec": "bash test/probe/exec.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "diagnose": "bash scripts/diagnose.sh"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": {
    "name": "Andy Zhao",

{
  "name": "dsh-plugin-wsl-env",
  "version": "0.9.0",
  "description": "让 DeepSeek Harness 以 WSL 子系统作为会话的执行环境：shell、文件读写与命令执行均在子系统内完成，目录选择器与 GUI 终端同样定位到子系统路径，并通过子系统内的 bubblewrap 对命令进行沙箱隔离",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl",
    "windows"
  ],
  "type": "module",
  "types": "./lib/shell.d.ts",
  "main": "lib/shell.js",
  "exports": {
    ".": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./auto-preset": {
      "types": "./lib/auto-preset.d.ts",
      "default": "./lib/auto-preset.js"
    },
    "./auto-preset/locale/en.json": "./locale/auto-preset/en.json",
    "./auto-preset/locale/zh.json": "./locale/auto-preset/zh.json",
    "./file-reference-wsl": {
      "types": "./lib/file-reference-wsl.d.ts",
      "default": "./lib/file-reference-wsl.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./fs-routing": {
      "types": "./lib/fs-routing.d.ts",
      "default": "./lib/fs-routing.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./paths": {
      "types": "./lib/paths.d.ts",
      "default": "./lib/paths.js"
    },
    "./preflight": {
      "types": "./lib/preflight.d.ts",
      "default": "./lib/preflight.js"
    },
    "./picker": {
      "types": "./lib/picker.d.ts",
      "default": "./lib/picker.js"
    },
    "./picker/locale/en.json": "./locale/picker/en.json",
    "./picker/locale/zh.json": "./locale/picker/zh.json",
    "./preflight/locale/en.json": "./locale/preflight/en.json",
    "./preflight/locale/zh.json": "./locale/preflight/zh.json",
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./shell-env": {
      "types": "./lib/shell-env.d.ts",
      "default": "./lib/shell-env.js"
    },
    "./shell-env/locale/en.json": "./locale/shell-env/en.json",
    "./shell-env/locale/zh.json": "./locale/shell-env/zh.json",
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./subprocess/locale/en.json": "./locale/subprocess/en.json",
    "./subprocess/locale/zh.json": "./locale/subprocess/zh.json",
    "./workspace-files-wsl": {
      "types": "./lib/workspace-files-wsl.d.ts",
      "default": "./lib/workspace-files-wsl.js"
    },
    "./wsl": {
      "types": "./lib/wsl.d.ts",
      "default": "./lib/wsl.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "agent/*.sh",
    "locale/**/*.json",
    "cordis.patch.yml",
    "examples/**/*.yml",
    "README.md",
    "docs/README.zh.md",
    "docs/CONFIGURATION.md",
    "docs/LIMITATIONS.md",
    "docs/PARITY.md",
    "docs/PEER-PARITY.md",
    "docs/UPSTREAM-FSIO-EXPORT.md",
    "docs/UPSTREAM-TERMINAL-TITLE.md",
    "docs/ARCHITECTURE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "scripts/bootstrap.sh",
    "scripts/diagnose.sh"
  ],
  "scripts": {
    "test": "pnpm run lint:style && pnpm run test:syntax && pnpm run lint:build && pnpm run lint:types && pnpm run test:unit",
    "lint:types": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "lint:build": "node test/build-freshness.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=84 --test-coverage-functions=70 test/agent-exec.test.mjs test/agent-fs-script.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/fs-substrate.test.mjs test/fs.boot.test.mjs test/workspace-files-wsl.test.mjs test/composition.test.mjs test/provider.test.mjs test/file-reference-wsl.test.mjs test/fsio-agent.test.mjs test/fsio-text.test.mjs test/git-route.test.mjs test/listing.test.mjs test/paths.test.mjs test/ports.test.mjs test/preset-choice.test.mjs test/probe-cache.test.mjs test/preflight.test.mjs test/sandbox.test.mjs test/search-exec.test.mjs test/search-route.test.mjs test/shell.test.mjs test/terminal-activity.test.mjs test/terminal.test.mjs test/watcher.test.mjs test/wsl.test.mjs test/fs-decisions.test.mjs",
    "test:syntax": "node test/syntax.mjs",
    "test:unit": "node --test test/fs.boot.test.mjs test/fsio-text.test.mjs test/workspace-files-wsl.test.mjs test/composition.test.mjs test/provider.test.mjs test/file-reference-wsl.test.mjs test/paths.test.mjs test/listing.test.mjs test/shell.test.mjs test/terminal.test.mjs test/probe-cache.test.mjs test/preflight.test.mjs test/preset-choice.test.mjs test/sandbox.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/agent-fs-script.test.mjs test/fsio-agent.test.mjs test/fs-substrate.test.mjs test/agent-exec.test.mjs test/ports.test.mjs test/watcher.test.mjs test/wsl.test.mjs test/fs-decisions.test.mjs test/git-route.test.mjs test/fsio-text.test.mjs test/search-route.test.mjs test/search-exec.test.mjs test/terminal-activity.test.mjs",
    "lint:style": "node test/style.mjs",
    "prepublishOnly": "pnpm test",
    "probe": "bash test/probe/run.sh",
    "probe:missing-wsl": "bash test/probe/missing-wsl.sh",
    "probe:mode": "bash test/probe/mode.sh",
    "probe:picker": "bash test/probe/picker.sh",
    "probe:sandbox-off": "bash test/probe/sandbox-off.sh",
    "probe:terminal": "bash test/probe/terminal.sh",
    "probe:sandbox": "bash test/probe/sandbox.sh",
    "probe:sandbox-shell": "bash test/probe/sandbox-shell.sh",
    "sync:windows": "bash test/probe/sync-to-windows.sh",
    "probe:watch": "bash test/probe/watch.sh",
    "probe:agent": "bash test/probe/agent.sh",
    "probe:substrate": "bash test/probe/substrate.sh",
    "probe:exec": "bash test/probe/exec.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "diagnose": "bash scripts/diagnose.sh"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": {
    "name": "Andy Zhao",
    "url": "https://github.com/Big-Dao"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Big-Dao/dsh-plugin-wsl-env.git"
  },
  "homepage": "https://github.com/Big-Dao/dsh-plugin-wsl-env#readme",
  "bugs": {
    "url": "https://github.com/Big-Dao/dsh-plugin-wsl-env/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "~22.20.5",
    "js-yaml": "4.3.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-directory-picker": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess-local": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}

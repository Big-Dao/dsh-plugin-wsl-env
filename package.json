    "test:syntax": "node test/syntax.mjs",
    "test:unit": "node scripts/test-watchdog.mjs -- node --test --test-timeout=60000 test/fs.boot.test.mjs test/fsio-text.test.mjs test/composition.test.mjs test/provider.test.mjs test/file-reference-wsl.test.mjs test/paths.test.mjs test/listing.test.mjs test/shell.test.mjs test/shell-env.test.mjs test/terminal.test.mjs test/probe-cache.test.mjs test/writable-roots.test.mjs test/preflight.test.mjs test/preset-choice.test.mjs test/sandbox.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/agent-fs-script.test.mjs test/fsio-agent.test.mjs test/fs-substrate.test.mjs test/agent-exec.test.mjs test/ports.test.mjs test/watcher.test.mjs test/wsl.test.mjs test/fs-decisions.test.mjs test/git-exec.test.mjs test/git-route.test.mjs test/search-route.test.mjs test/search-exec.test.mjs test/terminal-activity.test.mjs test/session-scope.test.mjs test/session-runtime.test.mjs test/native-agent.test.mjs test/peers.test.mjs test/agent-shared.test.mjs test/distro-route.test.mjs test/fs-routing.test.mjs test/update-check.test.mjs test/doctor.test.mjs test/profile-preset.test.mjs test/packaging.test.mjs test/peer-canary.test.mjs test/probe-runner.test.mjs test/cwd-prompt.test.mjs test/cwd-prompt-tool.test.mjs test/wsl-doctor-tool.test.mjs test/wsl-doctor-command.test.mjs test/status.test.mjs test/client-host.test.mjs test/messages.test.mjs",
    "lint:style": "node test/style.mjs",
    "lint:links": "node scripts/check-links.mjs",
    "lint:requirements": "node scripts/check-requirements.mjs",
    "lint:docs": "node scripts/check-doc-consistency.mjs",
    "prepublishOnly": "pnpm test",
    "probe": "bash test/probe/run.sh",
    "probe:clean": "rm -rf test/probe/.scratch && mkdir -p test/probe/.scratch",
    "probe:all-closed": "bash test/probe/run-all-when-closed.sh",
    "probe:missing-wsl": "bash test/probe/missing-wsl.sh",
    "probe:mode": "bash test/probe/mode.sh",
    "probe:picker": "bash test/probe/picker.sh",
    "probe:sandbox-off": "bash test/probe/sandbox-off.sh",
    "probe:terminal": "bash test/probe/terminal.sh",
    "probe:sandbox": "bash test/probe/sandbox.sh",

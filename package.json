{
  "name": "dsh-plugin-wsl-env",
  "version": "0.1.10",
  "description": "\u8ba9 DeepSeek Harness \u4ee5 WSL \u5b50\u7cfb\u7edf\u4f5c\u4e3a\u4f1a\u8bdd\u7684\u6267\u884c\u73af\u5883\uff1ashell\u3001\u6587\u4ef6\u8bfb\u5199\u4e0e\u547d\u4ee4\u6267\u884c\u5747\u5728\u5b50\u7cfb\u7edf\u5185\u5b8c\u6210\uff0c\u76ee\u5f55\u9009\u62e9\u5668\u4e0e GUI \u7ec8\u7aef\u540c\u6837\u5b9a\u4f4d\u5230\u5b50\u7cfb\u7edf\u8def\u5f84\uff0c\u5e76\u901a\u8fc7\u5b50\u7cfb\u7edf\u5185\u7684 bubblewrap \u5bf9\u547d\u4ee4\u8fdb\u884c\u6c99\u7bb1\u9694\u79bb",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl",
    "windows"
  ],
  "type": "module",
  "main": "lib/shell.js",
  "exports": {
    ".": "./lib/shell.js",
    "./shell": "./lib/shell.js",
    "./fs": "./lib/fs.js",
    "./subprocess": "./lib/subprocess.js",
    "./picker": "./lib/picker.js",
    "./auto-preset": "./lib/auto-preset.js",
    "./shell-env": "./lib/shell-env.js",
    "./wsl": "./lib/wsl.js",
    "./paths": "./lib/paths.js",
    "./agent": "./lib/agent.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "agent/*.sh",
    "cordis.patch.yml",
    "examples/**/*.yml",
    "README.md",
    "docs/README.zh.md",
    "docs/CONFIGURATION.md",
    "docs/LIMITATIONS.md",
    "docs/PARITY.md",
    "docs/ARCHITECTURE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run lint:style && npm run test:syntax && npm run test:unit",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=70 test/paths.test.mjs test/listing.test.mjs test/shell.test.mjs test/terminal.test.mjs test/probe-cache.test.mjs test/preset-choice.test.mjs",
    "test:syntax": "node test/syntax.mjs",
    "test:unit": "node --test test/paths.test.mjs test/listing.test.mjs test/shell.test.mjs test/terminal.test.mjs test/probe-cache.test.mjs test/preset-choice.test.mjs test/sandbox.test.mjs test/agent-protocol.test.mjs test/agent.test.mjs test/fs-publish.test.mjs test/agent-exec.test.mjs test/ports.test.mjs test/watcher.test.mjs",
    "lint:style": "node test/style.mjs",
    "prepublishOnly": "npm test",
    "probe": "bash test/probe/run.sh",
    "probe:missing-wsl": "bash test/probe/missing-wsl.sh",
    "probe:mode": "bash test/probe/mode.sh",
    "probe:picker": "bash test/probe/picker.sh",
    "probe:sandbox-off": "bash test/probe/sandbox-off.sh",
    "probe:terminal": "bash test/probe/terminal.sh",
    "probe:sandbox": "bash test/probe/sandbox.sh",
    "probe:sandbox-shell": "bash test/probe/sandbox-shell.sh",
    "sync:windows": "bash test/probe/sync-to-windows.sh",
    "probe:watch": "bash test/probe/watch.sh",
    "probe:exec": "bash test/probe/exec.sh",
    "bootstrap": "bash scripts/bootstrap.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Andy Zhao",
    "url": "https://github.com/Big-Dao"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Big-Dao/dsh-plugin-wsl-env.git"
  },
  "homepage": "https://github.com/Big-Dao/dsh-plugin-wsl-env#readme",
  "bugs": {
    "url": "https://github.com/Big-Dao/dsh-plugin-wsl-env/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-directory-picker": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess-local": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}

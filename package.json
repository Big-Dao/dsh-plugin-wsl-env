    "probe:gui-preview-batch": "bash test/probe/gui-preview-batch.sh",
    "probe:file-reference": "bash test/probe/file-reference-9p.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "diagnose": "bash scripts/diagnose.sh",
    "doctor": "node scripts/doctor.mjs",
    "preset": "node scripts/profile-preset.mjs",
    "e2e:install": "bash test/e2e/install.sh",
    "canary:peers": "node scripts/peer-canary.mjs"

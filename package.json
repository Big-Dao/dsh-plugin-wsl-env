    "probe:watch": "bash test/probe/watch.sh",
    "probe:agent": "bash test/probe/agent.sh",
    "probe:substrate": "bash test/probe/substrate.sh",
    "probe:exec": "bash test/probe/exec.sh",
    "probe:fs-routing": "bash test/probe/fs-routing.sh",

{
  "name": "dsh-plugin-wsl-env",
  "version": "0.24.0",
  "description": "在 WSL 的 Linux 实例中打开项目工作区，在对应 Linux 空间中进行命令执行、运行 shell 脚本和文件访问，以获得全套 Linux Shell 工具链收益，并通过 bubblewrap 对命令进行沙箱隔离",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wsl",
    "windows"
  ],
  "type": "module",
  "types": "./lib/client-host.d.ts",
  "main": "lib/client-host.js",
  "exports": {
    ".": {
      "types": "./lib/client-host.d.ts",
      "default": "./lib/client-host.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./auto-preset": {
      "types": "./lib/auto-preset.d.ts",
      "default": "./lib/auto-preset.js"
    },
    "./auto-preset/locale/en.json": "./locale/auto-preset/en.json",
    "./auto-preset/locale/zh.json": "./locale/auto-preset/zh.json",
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./cwd-prompt": {
      "types": "./lib/cwd-prompt.d.ts",
      "default": "./lib/cwd-prompt.js"
    },
    "./cwd-prompt-tool": {
      "types": "./lib/cwd-prompt-tool.d.ts",
      "default": "./lib/cwd-prompt-tool.js"
    },
    "./file-reference-wsl": {
      "types": "./lib/file-reference-wsl.d.ts",
      "default": "./lib/file-reference-wsl.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./fs-routing": {
      "types": "./lib/fs-routing.d.ts",
      "default": "./lib/fs-routing.js"
    },
    "./index": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./paths": {
      "types": "./lib/paths.d.ts",
      "default": "./lib/paths.js"
    },
    "./picker": {
      "types": "./lib/picker.d.ts",
      "default": "./lib/picker.js"
    },
    "./picker/locale/en.json": "./locale/picker/en.json",
    "./picker/locale/zh.json": "./locale/picker/zh.json",
    "./preflight": {
      "types": "./lib/preflight.d.ts",
      "default": "./lib/preflight.js"
    },
    "./preflight/locale/en.json": "./locale/preflight/en.json",
    "./preflight/locale/zh.json": "./locale/preflight/zh.json",
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./shell-env": {
      "types": "./lib/shell-env.d.ts",
      "default": "./lib/shell-env.js"
    },
    "./status": {
      "types": "./lib/status.d.ts",
      "default": "./lib/status.js"
    },
    "./shell-env/locale/en.json": "./locale/shell-env/en.json",
    "./shell-env/locale/zh.json": "./locale/shell-env/zh.json",
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./subprocess/locale/en.json": "./locale/subprocess/en.json",
    "./subprocess/locale/zh.json": "./locale/subprocess/zh.json",
    "./update-check": {
      "types": "./lib/update-check.d.ts",
      "default": "./lib/update-check.js"
    },
    "./wsl": {
      "types": "./lib/wsl.d.ts",
      "default": "./lib/wsl.js"
    },
    "./wsl-doctor-command": {
      "types": "./lib/wsl-doctor-command.d.ts",
      "default": "./lib/wsl-doctor-command.js"
    },
    "./wsl-doctor-tool": {
      "types": "./lib/wsl-doctor-tool.d.ts",
      "default": "./lib/wsl-doctor-tool.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "agent/*.sh",
    "agent/native/linux-*/dsh-wsl-agent",
    "locale/**/*.json",
    "cordis.patch.yml",
    "client.js",
    "client.d.ts",
    "examples/**/*.yml",
    "README.md",
    "docs/README.zh.md",
    "docs/QUICKSTART.md",
    "docs/screenshots/*.png",
    "docs/PERFORMANCE.md",
    "docs/COMPATIBILITY.md",
    "docs/CONFIGURATION.md",
    "docs/LIMITATIONS.zh.md",
    "docs/CONFIGURATION.zh.md",
    "docs/QUICKSTART.zh.md",
    "docs/REQUIREMENTS.zh.md",
    "docs/LIMITATIONS.md",
    "docs/RELEASING.md",
    "docs/root-fs-routing.md",
    "docs/VALUE.zh.md",
    "docs/UPSTREAM-OPEN-IN-APP.md",
    "docs/adr/0002-native-agent.md",
    "docs/PARITY.md",
    "docs/PEER-PARITY.md",
    "docs/UPSTREAM-FSIO-EXPORT.md",
    "docs/UPSTREAM-LSP-SEAM.md",
    "docs/UPSTREAM-FILE-REFERENCE-SEAM.md",
    "docs/MIGRATION.md",
    "docs/UPSTREAM-SESSION-NOTICE.md",
    "docs/UPSTREAM-SERVICE-SWAP.md",
    "docs/AGENT-PROTOCOL-V7.md",
    "docs/UPSTREAM-TERMINAL-TITLE.md",
    "docs/API.md",
    "docs/ARCHITECTURE.md",
    "docs/DIAGNOSTICS.md",
    "docs/DIAGNOSTICS.zh.md",
    "docs/ROADMAP.md",
    "docs/ROADMAP-1.0.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "scripts/bootstrap.sh",
    "scripts/bootstrap-import.sh",
    "scripts/diagnose.sh",
    "scripts/doctor.mjs",
    "scripts/open-wsl-vscode.ps1",
    "scripts/profile-preset.mjs"
  ],

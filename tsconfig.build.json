{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "noEmitOnError": true,
    "sourceMap": false
  },
  // `types/dsh-services.d.ts` pulls in the peer packages' `declare module
  // '@deepseek-ai/cordis'` augmentations, so `ctx.sandboxPolicy` and friends
  // are typed in the build program too.
  "include": ["src/**/*.ts", "types/*.d.ts"]
}

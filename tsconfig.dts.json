{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "lib",
    "outDir": "lib",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "sourceMap": false

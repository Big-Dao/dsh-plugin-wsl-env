{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  // Every `lib/*.js` is GENERATED from its `src/*.ts` source by `pnpm run
  // build` — type-checked as TypeScript by the build program (`noEmitOnError`)
  // and byte-compared against the committed artifact by `lint:build` — so this
  // gate covers what is NOT generated: the tests and probes, plus the ambient
  // service types the build shares.
  "include": ["test/**/*.mjs", "types/*.d.ts"]
}

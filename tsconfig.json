{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  // lib/agent-protocol.js and lib/paths.js are GENERATED from their
  // src/*.ts sources by `pnpm run build`; they are type-checked as their
  // TypeScript sources (and kept fresh by lint:build), so the checkJs pass
  // over generated code is skipped.
  "include": ["lib/**/*.js", "test/**/*.mjs", "types/*.d.ts"],
  "exclude": ["lib/agent-protocol.js", "lib/paths.js", "lib/agent-errors.js", "lib/probe-cache.js", "lib/listing.js", "lib/fsio-text.js", "lib/fs-decisions.js", "lib/git-route.js", "lib/search-route.js"]
}
